# ============================================
#  EXEMPLO de configuração - copie para .env
# ============================================
#
#  Copie este arquivo para ".env" na raiz do projeto
#  e preencha com os seus valores reais:
#
#      cp .env.example .env
#
#  O arquivo .env NAO vai para o GitHub (esta no .gitignore).
#  Este arquivo .env.example SIM vai, e serve como documentacao
#  de quais variaveis o projeto espera.
#
#  IMPORTANTE: os NOMES das variaveis nao podem mudar sozinhos.
#  Eles estao escritos dentro de app/oauth2.py e app/database.py.
#  O que voce pode (e deve) mudar e o VALOR de cada uma.
#


# Chave secreta usada para assinar o token JWT.
# Qualquer string aleatoria longa serve. Gere a sua com:
#     python -c "import secrets; print(secrets.token_hex(32))"
# Troque este valor: se alguem descobrir, consegue forjar tokens
# de acesso validos para a sua API.
SECRET_KEY=


# Algoritmo de criptografia usado na assinatura do JWT.
# HS256 e o padrao e funciona bem. Nao precisa mudar.
ALGORITHM=HS256


# Validade do token de acesso, em minutos.
# 30 = trinta minutos. Ao expirar, o usuario faz login de novo.
ACCESS_TOKEN_EXPIRE_MINUTES=30


# String de conexao com o banco de dados.
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
#
# Exemplos:
#   local:  postgresql://postgres:suaSenha@localhost:5432/fastapi
#   online: postgresql://usuario:suaSenha@host:5432/fastapi
SQLALCHEMY_DATABASE_URL=postgresql://usuario:senha@localhost:5432/dbname
